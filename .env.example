# Telegram Video Downloader Bot - Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Bot token from @BotFather
BOT_TOKEN=""

# OPTIONAL: Proxy URL for Telegram and yt-dlp (useful in Iran)
# Examples:
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8080
# PROXY_URL=socks5://user:pass@127.0.0.1:1080
PROXY_URL=

# OPTIONAL: Path to Instagram cookies.txt (for private/instagram-login content)
# Export cookies from browser (EditThisCookie extension) in Netscape format
# INSTAGRAM_COOKIES=./cookies.txt
INSTAGRAM_COOKIES=

# OPTIONAL: Read Instagram cookies straight from a logged-in browser instead of
# a cookies.txt file. Supported: chrome, firefox, edge, brave, chromium, opera, vivaldi
# NOTE: close the browser first on Windows, otherwise the cookie DB is locked.
# INSTAGRAM_COOKIES_BROWSER=chrome
INSTAGRAM_COOKIES_BROWSER=

# Maximum file size in MB (Telegram limit is 50MB for bots, 2GB for premium)
MAX_FILE_MB=50

# Rate limit: max requests per user per minute
RATE_LIMIT_PER_MIN=5